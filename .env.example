# 任意: 外部の MapLibre スタイル URL（未設定なら同梱の Natural Earth 陸地データのみで描画）
# 利用するタイル提供元の利用規約・帰属表示・キャッシュ制限を必ず確認すること
# NEXT_PUBLIC_MAP_STYLE_URL=https://example.com/style.json

# 任意: 地図の配信元の差し替え（未設定なら APIキー不要の既定値）
# NEXT_PUBLIC_SATELLITE_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2024_3857/default/g/{z}/{y}/{x}.jpg
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=Sentinel-2 cloudless by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2024)
# NEXT_PUBLIC_SATELLITE_CREDIT=Sentinel-2 cloudless by EOX IT Services GmbH（Contains modified Copernicus Sentinel data 2024）
# NEXT_PUBLIC_SATELLITE_MAXZOOM=14
# NEXT_PUBLIC_TERRAIN_TILES=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# NEXT_PUBLIC_VECTOR_STYLE_BASE=https://tiles.openfreemap.org/styles/
